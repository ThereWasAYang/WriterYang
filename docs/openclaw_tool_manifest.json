{
  "name": "writeryang-cli",
  "version": "0.1",
  "description": "Lightweight CLI contract for external agents. Not an MCP server.",
  "commands": [
    {
      "name": "status",
      "argv": ["novel", "status", "--project", "{project}", "--json", "--quiet"]
    },
    {
      "name": "validate",
      "argv": ["novel", "validate", "--project", "{project}", "--json", "--quiet"]
    },
    {
      "name": "ask",
      "argv": ["novel", "ask", "{request}", "--project", "{project}", "--provider", "config", "--json", "--quiet"]
    },
    {
      "name": "generate_chapter",
      "argv": ["novel", "generate-chapter", "{chapter_number}", "--project", "{project}", "--provider", "config", "--json", "--quiet"]
    },
    {
      "name": "audit_chapter",
      "argv": ["novel", "audit-chapter", "{chapter_number}", "--project", "{project}", "--provider", "config", "--json", "--quiet"]
    },
    {
      "name": "chapter_memory_show",
      "argv": ["novel", "chapter-memory", "show", "{chapter_number}", "--project", "{project}", "--json", "--quiet"]
    },
    {
      "name": "chapter_memory_generate",
      "argv": ["novel", "chapter-memory", "generate", "{chapter_number}", "--project", "{project}", "--provider", "config", "--force", "--json", "--quiet"]
    },
    {
      "name": "export_markdown",
      "argv": ["novel", "export", "markdown", "--project", "{project}", "--json", "--quiet"]
    }
  ]
}
