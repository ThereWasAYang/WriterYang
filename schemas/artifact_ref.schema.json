{
  "$defs": {
    "ArtifactKind": {
      "enum": [
        "plan",
        "candidate",
        "audit",
        "state_proposal",
        "chapter_memory",
        "acceptance",
        "segment_patch",
        "state",
        "timeline"
      ],
      "title": "ArtifactKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": 3,
      "title": "Schema Version",
      "type": "integer"
    },
    "artifact_id": {
      "pattern": "^art_[0-9a-f]{32}$",
      "title": "Artifact Id",
      "type": "string"
    },
    "kind": {
      "$ref": "#/$defs/ArtifactKind"
    },
    "path": {
      "minLength": 1,
      "title": "Path",
      "type": "string"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Sha256",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    }
  },
  "required": [
    "artifact_id",
    "kind",
    "path",
    "sha256",
    "created_at"
  ],
  "title": "ArtifactRef",
  "type": "object"
}
