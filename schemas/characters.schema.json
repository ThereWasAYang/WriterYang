{
  "$defs": {
    "Ability": {
      "additionalProperties": true,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "limitations": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Limitations"
        }
      },
      "required": [
        "name",
        "description"
      ],
      "title": "Ability",
      "type": "object"
    },
    "Character": {
      "additionalProperties": true,
      "properties": {
        "id": {
          "pattern": "^[a-z0-9_]+$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "role": {
          "minLength": 1,
          "title": "Role",
          "type": "string"
        },
        "gender": {
          "anyOf": [
            {
              "enum": [
                "男",
                "女",
                "未知"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Gender"
        },
        "reader_visible_summary": {
          "minLength": 1,
          "title": "Reader Visible Summary",
          "type": "string"
        },
        "aliases": {
          "items": {
            "type": "string"
          },
          "title": "Aliases",
          "type": "array"
        },
        "private_author_notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Private Author Notes"
        },
        "appearance": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Appearance"
        },
        "personality": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Personality"
        },
        "relationships": {
          "items": {
            "$ref": "#/$defs/Relationship"
          },
          "title": "Relationships",
          "type": "array"
        },
        "abilities": {
          "items": {
            "$ref": "#/$defs/Ability"
          },
          "title": "Abilities",
          "type": "array"
        },
        "secrets": {
          "items": {
            "$ref": "#/$defs/Secret"
          },
          "title": "Secrets",
          "type": "array"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "role",
        "reader_visible_summary"
      ],
      "title": "Character",
      "type": "object"
    },
    "Relationship": {
      "additionalProperties": true,
      "properties": {
        "target_id": {
          "title": "Target Id",
          "type": "string"
        },
        "type": {
          "title": "Type",
          "type": "string"
        },
        "reader_visible": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reader Visible"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        }
      },
      "required": [
        "target_id",
        "type"
      ],
      "title": "Relationship",
      "type": "object"
    },
    "Secret": {
      "additionalProperties": true,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "visibility": {
          "enum": [
            "reader_visible",
            "hidden",
            "partially_revealed"
          ],
          "title": "Visibility",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "planned_reveal": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Planned Reveal"
        }
      },
      "required": [
        "id",
        "visibility",
        "description"
      ],
      "title": "Secret",
      "type": "object"
    }
  },
  "additionalProperties": true,
  "properties": {
    "schema_version": {
      "default": 2,
      "minimum": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "characters": {
      "items": {
        "$ref": "#/$defs/Character"
      },
      "title": "Characters",
      "type": "array"
    }
  },
  "title": "CharactersFile",
  "type": "object"
}
