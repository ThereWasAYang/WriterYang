{
  "$defs": {
    "EmbeddingProviderConfig": {
      "additionalProperties": false,
      "properties": {
        "provider": {
          "minLength": 1,
          "title": "Provider",
          "type": "string"
        },
        "model": {
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "api_key_env": {
          "anyOf": [
            {
              "pattern": "^[A-Z][A-Z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Api Key Env"
        },
        "base_url_env": {
          "anyOf": [
            {
              "pattern": "^[A-Z][A-Z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Base Url Env"
        },
        "dimensions": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dimensions"
        },
        "batch_size": {
          "default": 16,
          "exclusiveMinimum": 0,
          "title": "Batch Size",
          "type": "integer"
        },
        "timeout_seconds": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timeout Seconds"
        },
        "max_retries": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Retries"
        }
      },
      "required": [
        "provider",
        "model"
      ],
      "title": "EmbeddingProviderConfig",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": 3,
      "title": "Schema Version",
      "type": "integer"
    },
    "active_provider": {
      "default": "local",
      "minLength": 1,
      "title": "Active Provider",
      "type": "string"
    },
    "providers": {
      "additionalProperties": {
        "$ref": "#/$defs/EmbeddingProviderConfig"
      },
      "minProperties": 1,
      "title": "Providers",
      "type": "object"
    }
  },
  "required": [
    "providers"
  ],
  "title": "EmbeddingsConfig",
  "type": "object"
}
