{
  "$defs": {
    "ForeshadowingThread": {
      "additionalProperties": true,
      "properties": {
        "id": {
          "pattern": "^[a-z0-9_]+$",
          "title": "Id",
          "type": "string"
        },
        "type": {
          "minLength": 1,
          "title": "Type",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "introduced_in_chapter": {
          "minimum": 1,
          "title": "Introduced In Chapter",
          "type": "integer"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "status": {
          "enum": [
            "active",
            "inactive",
            "resolved",
            "unresolved",
            "deprecated"
          ],
          "title": "Status",
          "type": "string"
        },
        "importance": {
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ],
          "title": "Importance",
          "type": "string"
        },
        "reader_visible": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reader Visible"
        },
        "hidden_truth": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hidden Truth"
        },
        "hidden_truth_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hidden Truth Id"
        },
        "planned_payoff": {
          "anyOf": [
            {
              "$ref": "#/$defs/PlannedPayoff"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "related_entity_ids": {
          "items": {
            "type": "string"
          },
          "title": "Related Entity Ids",
          "type": "array"
        }
      },
      "required": [
        "id",
        "type",
        "title",
        "introduced_in_chapter",
        "description",
        "status",
        "importance"
      ],
      "title": "ForeshadowingThread",
      "type": "object"
    },
    "PlannedPayoff": {
      "additionalProperties": true,
      "properties": {
        "chapter": {
          "minimum": 1,
          "title": "Chapter",
          "type": "integer"
        },
        "description": {
          "title": "Description",
          "type": "string"
        }
      },
      "required": [
        "chapter",
        "description"
      ],
      "title": "PlannedPayoff",
      "type": "object"
    }
  },
  "additionalProperties": true,
  "properties": {
    "schema_version": {
      "default": 3,
      "title": "Schema Version",
      "type": "integer"
    },
    "foreshadowing_threads": {
      "items": {
        "$ref": "#/$defs/ForeshadowingThread"
      },
      "title": "Foreshadowing Threads",
      "type": "array"
    }
  },
  "title": "ForeshadowingFile",
  "type": "object"
}
