{
  "$defs": {
    "Item": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z0-9_]+$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "type": {
          "minLength": 1,
          "title": "Type",
          "type": "string"
        },
        "reader_visible_summary": {
          "minLength": 1,
          "title": "Reader Visible Summary",
          "type": "string"
        },
        "private_author_notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Private Author Notes"
        },
        "origin": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Origin"
        },
        "special_properties": {
          "items": {
            "$ref": "#/$defs/SpecialProperty"
          },
          "title": "Special Properties",
          "type": "array"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "type",
        "reader_visible_summary"
      ],
      "title": "Item",
      "type": "object"
    },
    "SpecialProperty": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "title": "Description",
          "type": "string"
        },
        "visibility": {
          "enum": [
            "reader_visible",
            "hidden",
            "partially_revealed"
          ],
          "title": "Visibility",
          "type": "string"
        }
      },
      "required": [
        "description",
        "visibility"
      ],
      "title": "SpecialProperty",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": 3,
      "title": "Schema Version",
      "type": "integer"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/Item"
      },
      "title": "Items",
      "type": "array"
    }
  },
  "title": "ItemsFile",
  "type": "object"
}
