          "type": "string"
        },
        "instruction": {
          "minLength": 1,
          "title": "Instruction",
          "type": "string"
        },
        "target_files": {
          "items": {
            "type": "string"
          },
          "title": "Target Files",
          "type": "array"
        },
        "domains": {
          "items": {
            "enum": [
              "characters",
              "locations",
              "items",
              "world",
              "hidden_truths",
              "foreshadowing",
              "current_state",
              "timeline"
            ],
            "type": "string"
          },
          "title": "Domains",
          "type": "array"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "batch_id",
        "instruction",
        "reason"
      ],
      "title": "MemoryChangeBatch",
      "type": "object"
    }
  },
  "additionalProperties": true,
  "properties": {
