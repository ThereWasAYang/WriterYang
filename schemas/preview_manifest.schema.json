{
  "$defs": {
    "ArtifactKind": {
      "enum": [
        "plan",
        "candidate",
        "audit",
        "state_proposal",
        "chapter_memory",
        "acceptance",
        "segment_patch",
        "state",
        "timeline"
      ],
      "title": "ArtifactKind",
      "type": "string"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "default": 3,
          "title": "Schema Version",
          "type": "integer"
        },
        "artifact_id": {
          "pattern": "^art_[0-9a-f]{32}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ArtifactKind"
        },
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "kind",
        "path",
        "sha256",
        "created_at"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "PreviewSourceChapter": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "default": 3,
          "title": "Schema Version",
          "type": "integer"
        },
        "chapter_number": {
          "minimum": 1,
          "title": "Chapter Number",
          "type": "integer"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "source_kind": {
          "enum": [
            "draft",
            "polished"
          ],
          "title": "Source Kind",
          "type": "string"
        },
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "artifact_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "chapter_number",
        "title",
        "source_kind",
        "path",
        "sha256"
      ],
      "title": "PreviewSourceChapter",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": 3,
      "title": "Schema Version",
      "type": "integer"
    },
    "preview_id": {
      "pattern": "^preview_[0-9]{8}_[0-9]{6}_[0-9]{6}$",
      "title": "Preview Id",
      "type": "string"
    },
    "package_kind": {
      "const": "preview",
      "default": "preview",
      "title": "Package Kind",
      "type": "string"
    },
    "production_eligible": {
      "const": false,
      "default": false,
      "title": "Production Eligible",
      "type": "boolean"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "source_kind": {
      "enum": [
        "draft",
        "polished"
      ],
      "title": "Source Kind",
      "type": "string"
    },
    "source_chapters": {
      "items": {
        "$ref": "#/$defs/PreviewSourceChapter"
      },
      "minItems": 1,
      "title": "Source Chapters",
      "type": "array"
    },
    "content_path": {
      "minLength": 1,
      "title": "Content Path",
      "type": "string"
    },
    "content_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Content Sha256",
      "type": "string"
    },
    "warning": {
      "minLength": 1,
      "title": "Warning",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    }
  },
  "required": [
    "preview_id",
    "title",
    "source_kind",
    "source_chapters",
    "content_path",
    "content_sha256",
    "warning",
    "created_at"
  ],
  "title": "PreviewManifest",
  "type": "object"
}
