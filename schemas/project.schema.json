{
  "$defs": {
    "Narration": {
      "additionalProperties": true,
      "properties": {
        "pov": {
          "title": "Pov",
          "type": "string"
        },
        "tense": {
          "title": "Tense",
          "type": "string"
        }
      },
      "required": [
        "pov",
        "tense"
      ],
      "title": "Narration",
      "type": "object"
    },
    "TargetLength": {
      "additionalProperties": true,
      "properties": {
        "type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Type"
        },
        "planned_chapters": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Planned Chapters"
        }
      },
      "title": "TargetLength",
      "type": "object"
    }
  },
  "additionalProperties": true,
  "properties": {
    "schema_version": {
      "default": 1,
      "minimum": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "project_id": {
      "minLength": 1,
      "pattern": "^[a-z0-9_]+$",
      "title": "Project Id",
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "language": {
      "minLength": 1,
      "title": "Language",
      "type": "string"
    },
    "genre": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Genre",
      "type": "array"
    },
    "narration": {
      "$ref": "#/$defs/Narration"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    },
    "target_length": {
      "anyOf": [
        {
          "$ref": "#/$defs/TargetLength"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "default_style_profile_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Default Style Profile Id"
    }
  },
  "required": [
    "project_id",
    "title",
    "language",
    "genre",
    "narration",
    "created_at",
    "updated_at"
  ],
  "title": "ProjectConfig",
  "type": "object"
}
