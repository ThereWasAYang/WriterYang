{
  "$defs": {
    "ArtifactKind": {
      "enum": [
        "plan",
        "candidate",
        "audit",
        "state_proposal",
        "chapter_memory",
        "acceptance",
        "segment_patch",
        "state",
        "timeline"
      ],
      "title": "ArtifactKind",
      "type": "string"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "default": 3,
          "title": "Schema Version",
          "type": "integer"
        },
        "artifact_id": {
          "pattern": "^art_[0-9a-f]{32}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ArtifactKind"
        },
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "kind",
        "path",
        "sha256",
        "created_at"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "AuditBinding": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "default": 3,
          "title": "Schema Version",
          "type": "integer"
        },
        "audit": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "candidate": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "context_snapshot_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Context Snapshot Hash",
          "type": "string"
        },
        "policy_version": {
          "minLength": 1,
          "title": "Policy Version",
          "type": "string"
        }
      },
      "required": [
        "audit",
        "candidate",
        "context_snapshot_hash",
        "policy_version"
      ],
      "title": "AuditBinding",
      "type": "object"
    },
    "RevisionSessionPhase": {
      "enum": [
        "awaiting_patch",
        "running",
        "awaiting_review",
        "ready_to_commit",
        "committing",
        "committed",
        "archived",
        "failed_recoverable",
        "cancelled"
      ],
      "title": "RevisionSessionPhase",
      "type": "string"
    },
    "SegmentSelection": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "default": 3,
          "title": "Schema Version",
          "type": "integer"
        },
        "selection_id": {
          "pattern": "^selection_[0-9a-f]{32}$",
          "title": "Selection Id",
          "type": "string"
        },
        "chapter_number": {
          "minimum": 1,
          "title": "Chapter Number",
          "type": "integer"
        },
        "source_candidate": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "start_block": {
          "minimum": 1,
          "title": "Start Block",
          "type": "integer"
        },
        "end_block": {
          "minimum": 1,
          "title": "End Block",
          "type": "integer"
        },
        "selected_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Selected Sha256",
          "type": "string"
        },
        "prefix_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Prefix Sha256",
          "type": "string"
        },
        "suffix_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Suffix Sha256",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        }
      },
      "required": [
        "selection_id",
        "chapter_number",
        "source_candidate",
        "start_block",
        "end_block",
        "selected_sha256",
        "prefix_sha256",
        "suffix_sha256",
        "created_at"
      ],
      "title": "SegmentSelection",
      "type": "object"
    },
    "StateProposalBinding": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "default": 3,
          "title": "Schema Version",
          "type": "integer"
        },
        "proposal": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "candidate": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "audit": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "base_state_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Base State Sha256",
          "type": "string"
        },
        "base_timeline_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Base Timeline Sha256",
          "type": "string"
        }
      },
      "required": [
        "proposal",
        "candidate",
        "audit",
        "base_state_sha256",
        "base_timeline_sha256"
      ],
      "title": "StateProposalBinding",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": 3,
      "title": "Schema Version",
      "type": "integer"
    },
    "revision_session_id": {
      "pattern": "^revision_session_[0-9]{8}_[0-9]{6}_[0-9]{6}$",
      "title": "Revision Session Id",
      "type": "string"
    },
    "chapter_number": {
      "minimum": 1,
      "title": "Chapter Number",
      "type": "integer"
    },
    "base_acceptance_commit_id": {
      "minLength": 1,
      "title": "Base Acceptance Commit Id",
      "type": "string"
    },
    "instruction": {
      "minLength": 1,
      "title": "Instruction",
      "type": "string"
    },
    "phase": {
      "$ref": "#/$defs/RevisionSessionPhase"
    },
    "selection": {
      "$ref": "#/$defs/SegmentSelection"
    },
    "patch": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "candidate": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "audit": {
      "anyOf": [
        {
          "$ref": "#/$defs/AuditBinding"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "state_proposal": {
      "anyOf": [
        {
          "$ref": "#/$defs/StateProposalBinding"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "projection_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Projection Path"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "revision_session_id",
    "chapter_number",
    "base_acceptance_commit_id",
    "instruction",
    "phase",
    "selection",
    "created_at",
    "updated_at"
  ],
  "title": "RevisionSession",
  "type": "object"
}
