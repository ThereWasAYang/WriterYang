{
  "$defs": {
    "AgentRunStep": {
      "additionalProperties": true,
      "properties": {
        "step_id": {
          "minLength": 1,
          "title": "Step Id",
          "type": "string"
        },
        "agent": {
          "minLength": 1,
          "title": "Agent",
          "type": "string"
        },
        "input_files": {
          "items": {
            "type": "string"
          },
          "title": "Input Files",
          "type": "array"
        },
        "output_files": {
          "items": {
            "type": "string"
          },
          "title": "Output Files",
          "type": "array"
        },
        "status": {
          "enum": [
            "pending",
            "running",
            "completed",
            "failed",
            "cancelled"
          ],
          "title": "Status",
          "type": "string"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        }
      },
      "required": [
        "step_id",
        "agent",
        "status"
      ],
      "title": "AgentRunStep",
      "type": "object"
    }
  },
  "additionalProperties": true,
  "properties": {
    "run_id": {
      "minLength": 1,
      "pattern": "^run_[0-9]{8}_[0-9]{6}_[0-9]{6}$",
      "title": "Run Id",
      "type": "string"
    },
    "task": {
      "minLength": 1,
      "title": "Task",
      "type": "string"
    },
    "chapter_number": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Chapter Number"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "ended_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ended At"
    },
    "status": {
      "enum": [
        "pending",
        "running",
        "completed",
        "failed",
        "cancelled"
      ],
      "title": "Status",
      "type": "string"
    },
    "steps": {
      "items": {
        "$ref": "#/$defs/AgentRunStep"
      },
      "title": "Steps",
      "type": "array"
    },
    "input_files": {
      "items": {
        "type": "string"
      },
      "title": "Input Files",
      "type": "array"
    },
    "output_files": {
      "items": {
        "type": "string"
      },
      "title": "Output Files",
      "type": "array"
    },
    "errors": {
      "items": {
        "type": "string"
      },
      "title": "Errors",
      "type": "array"
    }
  },
  "required": [
    "run_id",
    "task",
    "started_at",
    "status"
  ],
  "title": "AgentRunLog",
  "type": "object"
}
