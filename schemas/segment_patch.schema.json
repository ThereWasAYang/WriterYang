{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": 3,
      "title": "Schema Version",
      "type": "integer"
    },
    "patch_id": {
      "pattern": "^patch_[0-9a-f]{32}$",
      "title": "Patch Id",
      "type": "string"
    },
    "selection_id": {
      "pattern": "^selection_[0-9a-f]{32}$",
      "title": "Selection Id",
      "type": "string"
    },
    "source_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Sha256",
      "type": "string"
    },
    "start_block": {
      "minimum": 1,
      "title": "Start Block",
      "type": "integer"
    },
    "end_block": {
      "minimum": 1,
      "title": "End Block",
      "type": "integer"
    },
    "replacement_markdown": {
      "minLength": 1,
      "title": "Replacement Markdown",
      "type": "string"
    },
    "addressed_issue_ids": {
      "items": {
        "type": "string"
      },
      "title": "Addressed Issue Ids",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    }
  },
  "required": [
    "patch_id",
    "selection_id",
    "source_sha256",
    "start_block",
    "end_block",
    "replacement_markdown",
    "created_at"
  ],
  "title": "SegmentPatch",
  "type": "object"
}
