{
  "$defs": {
    "StateChange": {
      "additionalProperties": true,
      "properties": {
        "id": {
          "pattern": "^[a-z0-9_]+$",
          "title": "Id",
          "type": "string"
        },
        "chapter": {
          "minimum": 1,
          "title": "Chapter",
          "type": "integer"
        },
        "entity_id": {
          "title": "Entity Id",
          "type": "string"
        },
        "field": {
          "minLength": 1,
          "title": "Field",
          "type": "string"
        },
        "new_value": {
          "title": "New Value"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "source": {
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "old_value": {
          "anyOf": [
            {},
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Old Value"
        }
      },
      "required": [
        "id",
        "chapter",
        "entity_id",
        "field",
        "new_value",
        "reason",
        "source"
      ],
      "title": "StateChange",
      "type": "object"
    },
    "TimelineEvent": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z0-9_]+$",
          "title": "Id",
          "type": "string"
        },
        "summary": {
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "reader_visible": {
          "title": "Reader Visible",
          "type": "boolean"
        },
        "narrative_position": {
          "$ref": "#/$defs/TimelineNarrativePosition"
        },
        "story_position": {
          "$ref": "#/$defs/TimelineStoryPosition"
        },
        "event_role": {
          "anyOf": [
            {
              "enum": [
                "current_action",
                "flashback",
                "memory",
                "revelation",
                "summary",
                "backstory"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Event Role"
        },
        "location_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Location Id"
        },
        "participant_ids": {
          "items": {
            "type": "string"
          },
          "title": "Participant Ids",
          "type": "array"
        },
        "causes": {
          "items": {
            "type": "string"
          },
          "title": "Causes",
          "type": "array"
        },
        "effects": {
          "items": {
            "type": "string"
          },
          "title": "Effects",
          "type": "array"
        },
        "state_change_ids": {
          "items": {
            "type": "string"
          },
          "title": "State Change Ids",
          "type": "array"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        }
      },
      "required": [
        "id",
        "summary",
        "reader_visible",
        "narrative_position",
        "story_position"
      ],
      "title": "TimelineEvent",
      "type": "object"
    },
    "TimelineNarrativePosition": {
      "additionalProperties": true,
      "properties": {
        "chapter": {
          "minimum": 1,
          "title": "Chapter",
          "type": "integer"
        },
        "scene": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scene"
        },
        "sequence": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sequence"
        }
      },
      "required": [
        "chapter"
      ],
      "title": "TimelineNarrativePosition",
      "type": "object"
    },
    "TimelineStoryPosition": {
      "additionalProperties": true,
      "properties": {
        "time_label": {
          "minLength": 1,
          "title": "Time Label",
          "type": "string"
        },
        "order": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Order"
        },
        "thread_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Thread Id"
        },
        "certainty": {
          "anyOf": [
            {
              "enum": [
                "certain",
                "inferred",
                "uncertain"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Certainty"
        }
      },
      "required": [
        "time_label"
      ],
      "title": "TimelineStoryPosition",
      "type": "object"
    }
  },
  "additionalProperties": true,
  "properties": {
    "schema_version": {
      "default": 2,
      "minimum": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "chapter_number": {
      "minimum": 1,
      "title": "Chapter Number",
      "type": "integer"
    },
    "state_changes": {
      "items": {
        "$ref": "#/$defs/StateChange"
      },
      "title": "State Changes",
      "type": "array"
    },
    "timeline_events": {
      "items": {
        "$ref": "#/$defs/TimelineEvent"
      },
      "title": "Timeline Events",
      "type": "array"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    }
  },
  "required": [
    "chapter_number",
    "created_at"
  ],
  "title": "StateUpdateProposal",
  "type": "object"
}
