{
  "$defs": {
    "TimelineEvent": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z0-9_]+$",
          "title": "Id",
          "type": "string"
        },
        "summary": {
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "reader_visible": {
          "title": "Reader Visible",
          "type": "boolean"
        },
        "narrative_position": {
          "anyOf": [
            {
              "$ref": "#/$defs/TimelineNarrativePosition"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "story_position": {
          "$ref": "#/$defs/TimelineStoryPosition"
        },
        "event_role": {
          "anyOf": [
            {
              "enum": [
                "current_action",
                "flashback",
                "memory",
                "revelation",
                "summary",
                "backstory"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Event Role"
        },
        "location_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Location Id"
        },
        "participant_ids": {
          "items": {
            "type": "string"
          },
          "title": "Participant Ids",
          "type": "array"
        },
        "causes": {
          "items": {
            "type": "string"
          },
          "title": "Causes",
          "type": "array"
        },
        "effects": {
          "items": {
            "type": "string"
          },
          "title": "Effects",
          "type": "array"
        },
        "state_change_ids": {
          "items": {
            "type": "string"
          },
          "title": "State Change Ids",
          "type": "array"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        }
      },
      "required": [
        "id",
        "summary",
        "reader_visible",
        "story_position"
      ],
      "title": "TimelineEvent",
      "type": "object"
    },
    "TimelineNarrativePosition": {
      "additionalProperties": true,
      "properties": {
        "chapter": {
          "minimum": 1,
          "title": "Chapter",
          "type": "integer"
        },
        "scene": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scene"
        },
        "sequence": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sequence"
        }
      },
      "required": [
        "chapter"
      ],
      "title": "TimelineNarrativePosition",
      "type": "object"
    },
    "TimelineStoryPosition": {
      "additionalProperties": true,
      "properties": {
        "time_label": {
          "minLength": 1,
          "title": "Time Label",
          "type": "string"
        },
        "order": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Order"
        },
        "thread_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Thread Id"
        },
        "certainty": {
          "anyOf": [
            {
              "enum": [
                "certain",
                "inferred",
                "uncertain"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Certainty"
        }
      },
      "required": [
        "time_label"
      ],
      "title": "TimelineStoryPosition",
      "type": "object"
    }
  },
  "additionalProperties": true,
  "properties": {
    "schema_version": {
      "default": 3,
      "title": "Schema Version",
      "type": "integer"
    },
    "events": {
      "items": {
        "$ref": "#/$defs/TimelineEvent"
      },
      "title": "Events",
      "type": "array"
    }
  },
  "title": "TimelineFile",
  "type": "object"
}
