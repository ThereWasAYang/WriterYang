{
  "$defs": {
    "ArtifactKind": {
      "enum": [
        "plan",
        "candidate",
        "audit",
        "state_proposal",
        "chapter_memory",
        "acceptance",
        "segment_patch",
        "state",
        "timeline"
      ],
      "title": "ArtifactKind",
      "type": "string"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "default": 3,
          "title": "Schema Version",
          "type": "integer"
        },
        "artifact_id": {
          "pattern": "^art_[0-9a-f]{32}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ArtifactKind"
        },
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "kind",
        "path",
        "sha256",
        "created_at"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "BudgetUsage": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "default": 3,
          "title": "Schema Version",
          "type": "integer"
        },
        "chapters": {
          "default": 0,
          "minimum": 0,
          "title": "Chapters",
          "type": "integer"
        },
        "model_calls": {
          "default": 0,
          "minimum": 0,
          "title": "Model Calls",
          "type": "integer"
        },
        "provider_attempts": {
          "default": 0,
          "minimum": 0,
          "title": "Provider Attempts",
          "type": "integer"
        },
        "auto_revision_rounds": {
          "default": 0,
          "minimum": 0,
          "title": "Auto Revision Rounds",
          "type": "integer"
        },
        "input_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        }
      },
      "title": "BudgetUsage",
      "type": "object"
    },
    "ProfileId": {
      "enum": [
        "scribe",
        "architect",
        "loremaster",
        "clerk"
      ],
      "title": "ProfileId",
      "type": "string"
    },
    "Surface": {
      "enum": [
        "cli",
        "web",
        "ask",
        "internal"
      ],
      "title": "Surface",
      "type": "string"
    },
    "TaskId": {
      "enum": [
        "inspiration",
        "style_guide",
        "canon",
        "plan",
        "write",
        "polish",
        "revision",
        "audit",
        "state_update",
        "chapter_memory",
        "intent_router",
        "memory_repair"
      ],
      "title": "TaskId",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": 3,
      "title": "Schema Version",
      "type": "integer"
    },
    "node_id": {
      "pattern": "^node_[0-9a-f]{32}$",
      "title": "Node Id",
      "type": "string"
    },
    "workflow_run_id": {
      "pattern": "^run_[0-9a-f]{32}$",
      "title": "Workflow Run Id",
      "type": "string"
    },
    "node_type": {
      "enum": [
        "command",
        "model",
        "deterministic"
      ],
      "title": "Node Type",
      "type": "string"
    },
    "name": {
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "parent_node_id": {
      "anyOf": [
        {
          "pattern": "^node_[0-9a-f]{32}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parent Node Id"
    },
    "request_id": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Request Id"
    },
    "parent_request_id": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parent Request Id"
    },
    "session_id": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Session Id"
    },
    "command_id": {
      "anyOf": [
        {
          "pattern": "^cmd_[0-9a-f]{32}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Command Id"
    },
    "surface": {
      "$ref": "#/$defs/Surface"
    },
    "task_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/TaskId"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "profile_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProfileId"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "provider": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Provider"
    },
    "model": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model"
    },
    "input_artifacts": {
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "title": "Input Artifacts",
      "type": "array"
    },
    "output_artifacts": {
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "title": "Output Artifacts",
      "type": "array"
    },
    "input_paths": {
      "items": {
        "type": "string"
      },
      "title": "Input Paths",
      "type": "array"
    },
    "output_paths": {
      "items": {
        "type": "string"
      },
      "title": "Output Paths",
      "type": "array"
    },
    "prompt_template_hash": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Prompt Template Hash"
    },
    "prompt_policy_hash": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Prompt Policy Hash"
    },
    "rendered_prompt_hash": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rendered Prompt Hash"
    },
    "retry_count": {
      "default": 0,
      "minimum": 0,
      "title": "Retry Count",
      "type": "integer"
    },
    "repair_count": {
      "default": 0,
      "minimum": 0,
      "title": "Repair Count",
      "type": "integer"
    },
    "budget_before": {
      "$ref": "#/$defs/BudgetUsage"
    },
    "budget_after": {
      "$ref": "#/$defs/BudgetUsage"
    },
    "status": {
      "enum": [
        "running",
        "completed",
        "failed",
        "cancelled"
      ],
      "title": "Status",
      "type": "string"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "ended_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ended At"
    },
    "error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error"
    },
    "recovery_command": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Recovery Command"
    }
  },
  "required": [
    "node_id",
    "workflow_run_id",
    "node_type",
    "name",
    "surface",
    "status",
    "started_at"
  ],
  "title": "WorkflowNodeRun",
  "type": "object"
}
