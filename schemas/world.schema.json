{
  "$defs": {
    "WorldRule": {
      "additionalProperties": true,
      "properties": {
        "id": {
          "pattern": "^[a-z0-9_]+$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "visibility": {
          "enum": [
            "reader_visible",
            "hidden",
            "partially_revealed"
          ],
          "title": "Visibility",
          "type": "string"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "known_by_character_ids": {
          "items": {
            "type": "string"
          },
          "title": "Known By Character Ids",
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "description",
        "visibility"
      ],
      "title": "WorldRule",
      "type": "object"
    }
  },
  "additionalProperties": true,
  "properties": {
    "schema_version": {
      "default": 2,
      "minimum": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "world_rules": {
      "items": {
        "$ref": "#/$defs/WorldRule"
      },
      "title": "World Rules",
      "type": "array"
    }
  },
  "title": "WorldFile",
  "type": "object"
}
