{
  "$defs": {
    "MemoryChangeFollowupAction": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "enum": [
            "none",
            "revise_outline",
            "reapprove_outline",
            "revise_content",
            "reaudit_chapters",
            "rebuild_state_proposal",
            "start_revision_session",
            "manual_review"
          ],
          "title": "Action",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "chapter_numbers": {
          "items": {
            "type": "integer"
          },
          "title": "Chapter Numbers",
          "type": "array"
        },
        "session_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Session Id"
        },
        "auto": {
          "default": false,
          "title": "Auto",
          "type": "boolean"
        }
      },
      "required": [
        "action",
        "reason"
      ],
      "title": "MemoryChangeFollowupAction",
      "type": "object"
    },
    "MemoryChangeImpact": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "default": 3,
          "title": "Schema Version",
          "type": "integer"
        },
        "domains": {
          "items": {
            "enum": [
              "characters",
              "locations",
              "items",
              "world",
              "hidden_truths",
              "foreshadowing",
              "current_state",
              "timeline"
            ],
            "type": "string"
          },
          "title": "Domains",
          "type": "array"
        },
        "entity_ids": {
          "items": {
            "type": "string"
          },
          "title": "Entity Ids",
          "type": "array"
        },
        "affected_files": {
          "items": {
            "type": "string"
          },
          "title": "Affected Files",
          "type": "array"
        },
        "affected_chapters": {
          "items": {
            "type": "integer"
          },
          "title": "Affected Chapters",
          "type": "array"
        },
        "affected_sessions": {
          "items": {
            "type": "string"
          },
          "title": "Affected Sessions",
          "type": "array"
        },
        "stale_chapters": {
          "items": {
            "type": "integer"
          },
          "title": "Stale Chapters",
          "type": "array"
        },
        "risk_level": {
          "default": "medium",
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "title": "Risk Level",
          "type": "string"
        },
        "reference_count": {
          "default": 0,
          "minimum": 0,
          "title": "Reference Count",
          "type": "integer"
        },
        "summary": {
          "default": "",
          "title": "Summary",
          "type": "string"
        }
      },
      "title": "MemoryChangeImpact",
      "type": "object"
    },
    "MemoryRepairOperation": {
      "additionalProperties": false,
      "properties": {
        "op": {
          "enum": [
            "add",
            "replace",
            "remove"
          ],
          "title": "Op",
          "type": "string"
        },
        "file": {
          "minLength": 1,
          "title": "File",
          "type": "string"
        },
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {},
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "op",
        "file",
        "path",
        "reason"
      ],
      "title": "MemoryRepairOperation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": 3,
      "title": "Schema Version",
      "type": "integer"
    },
    "repair_id": {
      "minLength": 1,
      "pattern": "^repair_[0-9]{8}_[0-9]{6}_[0-9]{6}$",
      "title": "Repair Id",
      "type": "string"
    },
    "created_by": {
      "const": "memory_repair",
      "default": "memory_repair",
      "title": "Created By",
      "type": "string"
    },
    "change_kind": {
      "default": "memory_repair",
      "enum": [
        "memory_repair",
        "setting_change"
      ],
      "title": "Change Kind",
      "type": "string"
    },
    "user_request": {
      "minLength": 1,
      "title": "User Request",
      "type": "string"
    },
    "target_files": {
      "items": {
        "type": "string"
      },
      "title": "Target Files",
      "type": "array"
    },
    "operations": {
      "items": {
        "$ref": "#/$defs/MemoryRepairOperation"
      },
      "title": "Operations",
      "type": "array"
    },
    "domains": {
      "items": {
        "enum": [
          "characters",
          "locations",
          "items",
          "world",
          "hidden_truths",
          "foreshadowing",
          "current_state",
          "timeline"
        ],
        "type": "string"
      },
      "title": "Domains",
      "type": "array"
    },
    "stage": {
      "default": "unknown",
      "enum": [
        "pre_creation",
        "outline_discussion",
        "content_review",
        "post_chapter",
        "unknown"
      ],
      "title": "Stage",
      "type": "string"
    },
    "impact": {
      "anyOf": [
        {
          "$ref": "#/$defs/MemoryChangeImpact"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "followup_actions": {
      "items": {
        "$ref": "#/$defs/MemoryChangeFollowupAction"
      },
      "title": "Followup Actions",
      "type": "array"
    },
    "risk_level": {
      "default": "medium",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "title": "Risk Level",
      "type": "string"
    },
    "confidence": {
      "default": 0.0,
      "maximum": 1,
      "minimum": 0,
      "title": "Confidence",
      "type": "number"
    },
    "assumptions": {
      "items": {
        "type": "string"
      },
      "title": "Assumptions",
      "type": "array"
    },
    "needs_user_confirmation": {
      "default": true,
      "title": "Needs User Confirmation",
      "type": "boolean"
    },
    "validation_before": {
      "additionalProperties": true,
      "title": "Validation Before",
      "type": "object"
    },
    "notes": {
      "items": {
        "type": "string"
      },
      "title": "Notes",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    }
  },
  "required": [
    "repair_id",
    "user_request",
    "created_at"
  ],
  "title": "MemoryRepairProposal",
  "type": "object"
}
