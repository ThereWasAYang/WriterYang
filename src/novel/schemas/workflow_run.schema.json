{
  "$defs": {
    "BudgetUsage": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "default": 3,
          "title": "Schema Version",
          "type": "integer"
        },
        "chapters": {
          "default": 0,
          "minimum": 0,
          "title": "Chapters",
          "type": "integer"
        },
        "model_calls": {
          "default": 0,
          "minimum": 0,
          "title": "Model Calls",
          "type": "integer"
        },
        "provider_attempts": {
          "default": 0,
          "minimum": 0,
          "title": "Provider Attempts",
          "type": "integer"
        },
        "auto_revision_rounds": {
          "default": 0,
          "minimum": 0,
          "title": "Auto Revision Rounds",
          "type": "integer"
        },
        "input_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        }
      },
      "title": "BudgetUsage",
      "type": "object"
    },
    "Surface": {
      "enum": [
        "cli",
        "web",
        "ask",
        "internal"
      ],
      "title": "Surface",
      "type": "string"
    },
    "WorkflowBudget": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "default": 3,
          "title": "Schema Version",
          "type": "integer"
        },
        "max_chapters": {
          "minimum": 1,
          "title": "Max Chapters",
          "type": "integer"
        },
        "max_model_calls": {
          "minimum": 0,
          "title": "Max Model Calls",
          "type": "integer"
        },
        "max_provider_attempts": {
          "minimum": 0,
          "title": "Max Provider Attempts",
          "type": "integer"
        },
        "max_auto_revision_rounds": {
          "minimum": 0,
          "title": "Max Auto Revision Rounds",
          "type": "integer"
        },
        "max_input_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Input Tokens"
        },
        "max_output_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Output Tokens"
        }
      },
      "required": [
        "max_chapters",
        "max_model_calls",
        "max_provider_attempts",
        "max_auto_revision_rounds"
      ],
      "title": "WorkflowBudget",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": 3,
      "title": "Schema Version",
      "type": "integer"
    },
    "workflow_run_id": {
      "pattern": "^run_[0-9a-f]{32}$",
      "title": "Workflow Run Id",
      "type": "string"
    },
    "root_command_id": {
      "pattern": "^cmd_[0-9a-f]{32}$",
      "title": "Root Command Id",
      "type": "string"
    },
    "root_request_id": {
      "minLength": 1,
      "title": "Root Request Id",
      "type": "string"
    },
    "surface": {
      "$ref": "#/$defs/Surface"
    },
    "budget": {
      "$ref": "#/$defs/WorkflowBudget"
    },
    "budget_usage": {
      "$ref": "#/$defs/BudgetUsage"
    },
    "node_ids": {
      "items": {
        "type": "string"
      },
      "title": "Node Ids",
      "type": "array"
    },
    "decision_ids": {
      "items": {
        "type": "string"
      },
      "title": "Decision Ids",
      "type": "array"
    },
    "request_ids": {
      "items": {
        "type": "string"
      },
      "title": "Request Ids",
      "type": "array"
    },
    "session_ids": {
      "items": {
        "type": "string"
      },
      "title": "Session Ids",
      "type": "array"
    },
    "status": {
      "enum": [
        "running",
        "completed",
        "failed",
        "cancelled",
        "awaiting_user"
      ],
      "title": "Status",
      "type": "string"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    },
    "ended_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ended At"
    }
  },
  "required": [
    "workflow_run_id",
    "root_command_id",
    "root_request_id",
    "surface",
    "budget",
    "status",
    "started_at",
    "updated_at"
  ],
  "title": "WorkflowRun",
  "type": "object"
}
